{
  "name": "tandem-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply tandem-db --local",
    "db:remote": "wrangler d1 migrations apply tandem-db --remote",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250927.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "~5.9.3",
    "wrangler": "^4.40.2"
  }
}
